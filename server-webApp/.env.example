PORT=4017
CLIENT_ORIGIN=http://localhost:5017
DATA_API_BASE_URL=http://localhost:4007
INTERNAL_API_KEY=replace-me
JWT_SECRET=replace-me
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEY_ENCRYPTION_KEY=replace-me
# Application-provided OpenAI access. Leave AI_ENABLED=false to turn it off.
OPENAI_API_KEY=
AI_ENABLED=false
# Placeholder model; verify against the live OpenAI catalogue.
AI_MODEL_DEFAULT=gpt-4o-mini
AI_TIMEOUT_MS=20000
# Per-user monthly token allowance (input + output) on the application key. User keys are not limited.
AI_APP_MONTHLY_TOKEN_LIMIT=100000
