# VM-only Compose interpolation file. Copy to .env next to docker-compose.yml
# (chmod 600 on the Droplet). Never commit .env.
#
# Compose substitutes ${VAR} from this file, then injects only the listed
# names into each container via docker-compose.yml `environment:`.
# It does not dump the whole file into both services.
#
# Do not put PORT, DATA_API_BASE_URL, or VITE_WEB_API_BASE_URL here.
# Compose sets ports and the internal data-API URL. The React API base is a
# Docker build-arg (empty = same-origin).
#
# Local `npm start` still uses each app's own .env — not this file.

MONGODB_URI=mongodb+srv://USER:PASSWORD@ATLAS_HOST/quizcontext-int?OPTIONS
INTERNAL_API_KEY=replace-me
JWT_SECRET=replace-me
AI_KEY_ENCRYPTION_KEY=replace-me
OPENAI_API_KEY=
AI_ENABLED=false
CLIENT_ORIGIN=https://int.quizcontext.app
AI_TIMEOUT_MS=20000
